# Meta WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=          # Permanent access token from Meta Business > System Users > Generate Token
WHATSAPP_PHONE_NUMBER_ID=       # Phone Number ID from Meta App > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=          # Any string you choose (e.g. "myverifytoken123") - used to verify webhook

# AI Model (OpenRouter or OpenAI-compatible)
OPENROUTER_API_KEY=             # API key from openrouter.ai (or use OPENAI_API_KEY if using OpenAI directly)
AI_MODEL=minimax/minimax-m2.5:free  # Model to use via OpenRouter

# Voice Transcription (Groq Whisper)
GROQ_API_KEY=                   # API key from console.groq.com — required for voice note transcription

# Google Sheets Live Fault Code Dataset
GOOGLE_SHEETS_CSV_URL=          # Published Google Sheets CSV link (File > Share > Publish to web > CSV)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=       # Supabase project URL (e.g. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # Supabase anon/public key (for frontend)
SUPABASE_SERVICE_ROLE_KEY=      # Supabase service role key (for backend/webhook)

# App Config
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production Tuning (optional)
AI_TIMEOUT_MS=12000             # Max time to wait for AI response (default: 12000ms)
ISSUE_ID_PREFIX=LG              # Prefix for generated issue IDs (e.g. LG-2026-123456)
